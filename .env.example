# Optional. Without a key the tool runs in Engine mode (fully offline, deterministic).
# With a key it also runs the Claude enhancement pass; every AI name is still
# re-validated against the verified facts and the character limit before it is shown.
ANTHROPIC_API_KEY=

# Optional overrides
OTA_NAMER_MODEL=claude-opus-5
PORT=5178
# Set HOST=0.0.0.0 when hosting on cloud/Docker to accept external connections
HOST=127.0.0.1

